# ============================================================
# Parcolo — Required Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Supabase (required) ---
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# --- App (optional — falls back to window.location.origin) ---
VITE_APP_URL="https://parcolo.com"

# --- Maps (optional — falls back to built-in public token) ---
VITE_MAPBOX_TOKEN="pk.your-url-restricted-mapbox-token"

# --- Payments (optional — enables in-app Yoco popup instead of redirect) ---
# Public key from your Yoco Dashboard (Online Payments -> API keys).
# When empty, payments fall back to the hosted-page redirect flow.
VITE_YOCO_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxx"

# ============================================================
# Edge Function Secrets (set via Supabase Dashboard > Settings > Functions)
# These are NOT VITE_ prefixed and must NOT be in this file.
# ============================================================
# SUPABASE_URL          — auto-injected by Supabase
# SUPABASE_ANON_KEY     — auto-injected by Supabase
# SUPABASE_SERVICE_ROLE_KEY — auto-injected by Supabase
# YOCO_SECRET_KEY       — Yoco payment gateway secret
# APP_URL               — custom domain for payment redirects (e.g. https://parcolo.com)
